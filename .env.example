# Environment variables used by serverless functions

# OpenAI API key for AI Code Reviewer
OPENAI_API_KEY=your_openai_api_key_here

# Optional: change model used by AI reviewer (defaults to gpt-4o-mini if not set)
OPENAI_MODEL=

# Deployment target (vercel/netlify/railway) - used in docs/workflows
DEPLOY_TARGET=vercel
